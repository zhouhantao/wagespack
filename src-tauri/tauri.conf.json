{
  "productName": "wagespack",
  "identifier": "local.wagespark.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "wagespack Pet",
        "url": "index.html?surface=pet",
        "width": 152,
        "height": 218,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "panel",
        "title": "wagespack Panel",
        "url": "index.html?surface=panel",
        "width": 408,
        "height": 390,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
